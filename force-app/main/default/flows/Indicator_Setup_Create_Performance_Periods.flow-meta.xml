        <locationX>0</locationX>
        <locationY>0</locationY>
        <collectionReference>fltPeriodTimePeriod</collectionReference>
        <iterationOrder>Asc</iterationOrder>
        <nextValueConnector>
            <targetReference>asgCaptureTimePeriodId</targetReference>
        </nextValueConnector>
        <noMoreValuesConnector>
            <targetReference>asgAddPeriodToCreate</targetReference>
        </noMoreValuesConnector>
