    <description>Creates the Indicator Performance Periods for an Indicator Assignment, re-using any Time Period that already has the same start and end dates and creating the rest. It uses one query and at most two record creates, however many periods there are.</description>
    <environments>Default</environments>
    <formulas>
        <description>End date of the current period before the last period is capped at inLastPeriodEnd.</description>
        <name>frmComputedPeriodEnd</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!inFirstPeriodStart}, {!varPeriodCounter} * {!frmMonthsPerPeriod}) - 1</expression>
    </formulas>
    <formulas>
        <description>End date of the current period; the last period ends on inLastPeriodEnd, so it can be shorter.</description>
        <name>frmCurrentPeriodEnd</name>
        <dataType>Date</dataType>
        <expression>IF({!varPeriodCounter} = {!varPeriodCount}, {!inLastPeriodEnd}, {!frmComputedPeriodEnd})</expression>
    </formulas>
    <formulas>
        <description>Current period end as a DateTime (midnight GMT), to match TimePeriod.EndDate.</description>
        <name>frmCurrentPeriodEndDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!frmCurrentPeriodEnd})</expression>
    </formulas>
    <formulas>
        <description>Time Period name: "2026" (Annually), "2026 Q1" (Quarterly) or "2026-01" (Monthly).</description>
        <name>frmCurrentPeriodName</name>
        <dataType>String</dataType>
        <expression>IF({!inFrequency} = &quot;Annually&quot;,
  TEXT(YEAR({!frmCurrentPeriodStart})),
  IF({!inFrequency} = &quot;Quarterly&quot;,
    TEXT(YEAR({!frmCurrentPeriodStart})) &amp; &quot; Q&quot; &amp; TEXT(CEILING(MONTH({!frmCurrentPeriodStart}) / 3)),
    LEFT(TEXT({!frmCurrentPeriodStart}), 7)
  )
)</expression>
    </formulas>
    <formulas>
        <description>Start date of the current period.</description>
        <name>frmCurrentPeriodStart</name>
        <dataType>Date</dataType>
        <expression>ADDMONTHS({!inFirstPeriodStart}, ({!varPeriodCounter} - 1) * {!frmMonthsPerPeriod})</expression>
    </formulas>
    <formulas>
        <description>Current period start as a DateTime (midnight GMT), to match TimePeriod.StartDate.</description>
        <name>frmCurrentPeriodStartDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!frmCurrentPeriodStart})</expression>
    </formulas>
    <formulas>
        <description>First period start as a DateTime (midnight GMT), used to limit the Time Period query.</description>
        <name>frmFirstPeriodStartDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!inFirstPeriodStart})</expression>
    </formulas>
    <formulas>
        <description>Last period end as a DateTime (midnight GMT), used to limit the Time Period query.</description>
        <name>frmLastPeriodEndDateTime</name>
        <dataType>DateTime</dataType>
        <expression>DATETIMEVALUE({!inLastPeriodEnd})</expression>
    </formulas>
    <formulas>
        <description>Number of months in each period for the chosen frequency.</description>
        <name>frmMonthsPerPeriod</name>
        <dataType>Number</dataType>
        <expression>IF({!inFrequency} = &quot;Annually&quot;, 12, IF({!inFrequency} = &quot;Quarterly&quot;, 3, 1))</expression>
        <scale>0</scale>
    </formulas>
    <formulas>
        <description>Performance period name: indicator name (trimmed to fit 255 characters), frequency and period name.</description>
        <name>frmPerformancePeriodName</name>
        <dataType>String</dataType>
        <expression>LEFT({!inIndicatorName}, 255 - LEN(&quot; - &quot; &amp; {!inFrequency} &amp; &quot; - &quot; &amp; {!frmCurrentPeriodName})) &amp; &quot; - &quot; &amp; {!inFrequency} &amp; &quot; - &quot; &amp; {!frmCurrentPeriodName}</expression>
    </formulas>
    <interviewLabel>Indicator Setup Create Performance Periods {!$Flow.CurrentDateTime}</interviewLabel>
