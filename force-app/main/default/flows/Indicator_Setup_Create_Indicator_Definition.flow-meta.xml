<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets outSucceeded = true; outErrorMessage = &quot;&quot;; outDuplicateFound = false.</description>
        <name>asgInitialiseResult</name>
        <label>Initialise Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outSucceeded</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outDuplicateFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>decInputsPresent</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets outSucceeded = false; outErrorMessage = {!$Flow.FaultMessage}.</description>
        <name>asgSetCreateError</name>
        <label>Set Create Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outSucceeded</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets outDuplicateFound = true; outErrorMessage = {!frmDuplicateMessage}. outSucceeded stays true because a duplicate is an expected result, not a failure.</description>
        <name>asgSetDuplicateFound</name>
        <label>Set Duplicate Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outDuplicateFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outIndicatorDefinitionId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varDuplicateIndicatorId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmDuplicateMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets outSucceeded = false; outErrorMessage = &quot;An indicator name, a status and either an existing unit of measure or a new unit of measure name and code are required.&quot;.</description>
        <name>asgSetInputError</name>
        <label>Set Input Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outSucceeded</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>An indicator name, a status and either an existing unit of measure or a new unit of measure name and code are required.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets outSucceeded = false; outErrorMessage = {!$Flow.FaultMessage}.</description>
        <name>asgSetLookupError</name>
        <label>Set Lookup Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outSucceeded</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets outUnitOfMeasureId = {!inUnitOfMeasureId}.</description>
        <name>asgUseExistingUnitOfMeasure</name>
        <label>Use Existing Unit of Measure</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outUnitOfMeasureId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inUnitOfMeasureId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>rcCreateIndicatorDefinition</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Routes on: &quot;New Unit of Measure&quot; when inCreateNewUnitOfMeasure = true -&gt; rcCreateUnitOfMeasure; &quot;Existing Unit of Measure&quot; otherwise -&gt; asgUseExistingUnitOfMeasure.</description>
        <name>decCreateNewUnitOfMeasure</name>
        <label>Create New Unit of Measure?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>asgUseExistingUnitOfMeasure</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Existing Unit of Measure</defaultConnectorLabel>
        <rules>
            <name>outNewUnitOfMeasure</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inCreateNewUnitOfMeasure</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>rcCreateUnitOfMeasure</targetReference>
            </connector>
            <label>New Unit of Measure</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes on: &quot;Duplicate Found&quot; when varDuplicateIndicatorId is null false -&gt; asgSetDuplicateFound; &quot;No Duplicate&quot; otherwise -&gt; decCreateNewUnitOfMeasure.</description>
        <name>decDuplicateIndicatorFound</name>
        <label>Duplicate Indicator Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>decCreateNewUnitOfMeasure</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Duplicate</defaultConnectorLabel>
        <rules>
            <name>outDuplicateIndicatorFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varDuplicateIndicatorId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>asgSetDuplicateFound</targetReference>
            </connector>
            <label>Duplicate Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes on: &quot;Inputs Present&quot; when inIndicatorName and inIndicatorStatus are not blank AND either (inCreateNewUnitOfMeasure = true with inNewUnitOfMeasureName and inNewUnitOfMeasureCode not blank) or (inCreateNewUnitOfMeasure = false with inUnitOfMeasureId not blank) -&gt; getDuplicateIndicatorDefinition; &quot;Invalid Inputs&quot; otherwise -&gt; asgSetInputError.</description>
        <name>decInputsPresent</name>
        <label>Inputs Present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>asgSetInputError</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid Inputs</defaultConnectorLabel>
        <rules>
            <name>outInputsPresent</name>
            <conditionLogic>1 AND 2 AND ((3 AND 4 AND 5) OR (6 AND 7))</conditionLogic>
            <conditions>
                <leftValueReference>inIndicatorName</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inIndicatorStatus</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inCreateNewUnitOfMeasure</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>true</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inNewUnitOfMeasureName</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inNewUnitOfMeasureCode</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inCreateNewUnitOfMeasure</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inUnitOfMeasureId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getDuplicateIndicatorDefinition</targetReference>
            </connector>
            <label>Inputs Present</label>
        </rules>
    </decisions>
    <description>Creates a new Indicator Definition and, when requested, a new custom Unit of Measure for it. If an Indicator Definition with the same name already exists, nothing is created and outDuplicateFound is returned.</description>
    <environments>Default</environments>
    <formulas>
        <name>frmDuplicateMessage</name>
        <dataType>String</dataType>
        <expression>&quot;An indicator named ‘&quot; &amp; {!inIndicatorName} &amp; &quot;’ already exists. Go back and choose a different name, or select Use an Existing Indicator.&quot;</expression>
    </formulas>
    <interviewLabel>Indicator Setup Create Indicator Definition {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subflow: Indicator Setup - Create Indicator Definition</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Creates an IndicatorDefinition with Name = {!inIndicatorName}, Description = {!inIndicatorDescription}, Status = {!inIndicatorStatus}, UnitOfMeasureId = {!outUnitOfMeasureId}. Stores the new Id in outIndicatorDefinitionId. On failure, routes to asgSetCreateError.</description>
        <name>rcCreateIndicatorDefinition</name>
        <label>Create Indicator Definition</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>outIndicatorDefinitionId</assignRecordIdToReference>
        <faultConnector>
            <targetReference>asgSetCreateError</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>inIndicatorDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>inIndicatorName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Status</field>
            <value>
                <elementReference>inIndicatorStatus</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UnitOfMeasureId</field>
            <value>
                <elementReference>outUnitOfMeasureId</elementReference>
            </value>
        </inputAssignments>
        <object>IndicatorDefinition</object>
    </recordCreates>
    <recordCreates>
        <description>Creates a UnitOfMeasure with Name = {!inNewUnitOfMeasureName}, UnitCode = {!inNewUnitOfMeasureCode}, Description = {!inNewUnitOfMeasureDescription}, Type = Custom. Status is not set, because UnitOfMeasure.Status only exists in some orgs; where it exists, the org default applies. Stores the new Id in outUnitOfMeasureId. On failure, routes to asgSetCreateError.</description>
        <name>rcCreateUnitOfMeasure</name>
        <label>Create Unit of Measure</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignRecordIdToReference>outUnitOfMeasureId</assignRecordIdToReference>
        <connector>
            <targetReference>rcCreateIndicatorDefinition</targetReference>
        </connector>
        <faultConnector>
            <targetReference>asgSetCreateError</targetReference>
        </faultConnector>
        <inputAssignments>
            <field>Description</field>
            <value>
                <elementReference>inNewUnitOfMeasureDescription</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Name</field>
            <value>
                <elementReference>inNewUnitOfMeasureName</elementReference>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>Type</field>
            <value>
                <stringValue>Custom</stringValue>
            </value>
        </inputAssignments>
        <inputAssignments>
            <field>UnitCode</field>
            <value>
                <elementReference>inNewUnitOfMeasureCode</elementReference>
            </value>
        </inputAssignments>
        <object>UnitOfMeasure</object>
    </recordCreates>
    <recordLookups>
        <description>Query IndicatorDefinition for the first record where Name = {!inIndicatorName} (not case-sensitive). Stores Id in varDuplicateIndicatorId. On failure, routes to asgSetLookupError.</description>
        <name>getDuplicateIndicatorDefinition</name>
        <label>Get Indicator Definition With Same Name</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>decDuplicateIndicatorFound</targetReference>
        </connector>
        <faultConnector>
            <targetReference>asgSetLookupError</targetReference>
        </faultConnector>
        <filterLogic>and</filterLogic>
        <filters>
            <field>Name</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inIndicatorName</elementReference>
            </value>
        </filters>
        <getFirstRecordOnly>true</getFirstRecordOnly>
        <object>IndicatorDefinition</object>
        <outputAssignments>
            <assignToReference>varDuplicateIndicatorId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>asgInitialiseResult</targetReference>
        </connector>
    </start>
    <status>Active</status>
