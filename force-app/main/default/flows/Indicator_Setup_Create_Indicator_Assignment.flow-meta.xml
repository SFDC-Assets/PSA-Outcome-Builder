<?xml version="1.0" encoding="UTF-8"?>
<Flow xmlns="http://soap.sforce.com/2006/04/metadata">
    <apiVersion>66.0</apiVersion>
    <areMetricsLoggedToDataCloud>false</areMetricsLoggedToDataCloud>
    <assignments>
        <description>Sets outSucceeded = true; outErrorMessage = &quot;&quot;; outDuplicateFound = false.</description>
        <name>asgInitialiseResult</name>
        <label>Initialise Result</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outSucceeded</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue></stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outDuplicateFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>decInputsPresent</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets outIndicatorAssignmentId = {!recAssignment.Id}.</description>
        <name>asgSetCreatedAssignmentId</name>
        <label>Set Created Assignment Id</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outIndicatorAssignmentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>recAssignment.Id</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets outSucceeded = false; outErrorMessage = {!$Flow.FaultMessage}.</description>
        <name>asgSetCreateError</name>
        <label>Set Create Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outSucceeded</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets outDuplicateFound = true; outIndicatorAssignmentId = {!varExistingAssignmentId}; outErrorMessage = &quot;This indicator is already assigned to the selected record.&quot;. outSucceeded stays true because a duplicate is an expected result, not a failure.</description>
        <name>asgSetDuplicateFound</name>
        <label>Set Duplicate Found</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outDuplicateFound</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>true</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outIndicatorAssignmentId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>varExistingAssignmentId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>This indicator is already assigned to the selected record.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets outSucceeded = false; outErrorMessage = &quot;An indicator definition, a measurement type of Outcome or Program, and the matching Outcome or Program are required.&quot;.</description>
        <name>asgSetInputError</name>
        <label>Set Input Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outSucceeded</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>An indicator definition, a measurement type of Outcome or Program, and the matching Outcome or Program are required.</stringValue>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets outSucceeded = false; outErrorMessage = {!$Flow.FaultMessage}.</description>
        <name>asgSetLookupError</name>
        <label>Set Lookup Error</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>outSucceeded</assignToReference>
            <operator>Assign</operator>
            <value>
                <booleanValue>false</booleanValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>outErrorMessage</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>$Flow.FaultMessage</elementReference>
            </value>
        </assignmentItems>
    </assignments>
    <assignments>
        <description>Sets recAssignment.Name = {!frmAssignmentName}, IndicatorDefinitionId = {!inIndicatorDefinitionId}, IndicatorAssignmentType = {!inAssignmentType}, Status = Active, OutcomeId = {!inOutcomeId}.</description>
        <name>asgSetOutcomeAssignment</name>
        <label>Set Outcome Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>recAssignment.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmAssignmentName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recAssignment.IndicatorDefinitionId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inIndicatorDefinitionId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recAssignment.IndicatorAssignmentType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inAssignmentType</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recAssignment.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recAssignment.OutcomeId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inOutcomeId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>rcCreateIndicatorAssignment</targetReference>
        </connector>
    </assignments>
    <assignments>
        <description>Sets recAssignment.Name = {!frmAssignmentName}, IndicatorDefinitionId = {!inIndicatorDefinitionId}, IndicatorAssignmentType = {!inAssignmentType}, Status = Active, ProgramId = {!inProgramId}.</description>
        <name>asgSetProgramAssignment</name>
        <label>Set Programme Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignmentItems>
            <assignToReference>recAssignment.Name</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>frmAssignmentName</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recAssignment.IndicatorDefinitionId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inIndicatorDefinitionId</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recAssignment.IndicatorAssignmentType</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inAssignmentType</elementReference>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recAssignment.Status</assignToReference>
            <operator>Assign</operator>
            <value>
                <stringValue>Active</stringValue>
            </value>
        </assignmentItems>
        <assignmentItems>
            <assignToReference>recAssignment.ProgramId</assignToReference>
            <operator>Assign</operator>
            <value>
                <elementReference>inProgramId</elementReference>
            </value>
        </assignmentItems>
        <connector>
            <targetReference>rcCreateIndicatorAssignment</targetReference>
        </connector>
    </assignments>
    <decisions>
        <description>Routes on: &quot;Outcome&quot; when inAssignmentType = &quot;Outcome&quot; -&gt; asgSetOutcomeAssignment; &quot;Programme&quot; otherwise -&gt; asgSetProgramAssignment.</description>
        <name>decAssignmentType</name>
        <label>Assignment Type?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>asgSetProgramAssignment</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Programme</defaultConnectorLabel>
        <rules>
            <name>outOutcome</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>inAssignmentType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Outcome</stringValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>asgSetOutcomeAssignment</targetReference>
            </connector>
            <label>Outcome</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes on: &quot;Duplicate Found&quot; when varExistingAssignmentId is null false -&gt; asgSetDuplicateFound; &quot;No Duplicate&quot; otherwise -&gt; decAssignmentType.</description>
        <name>decDuplicateAssignmentFound</name>
        <label>Duplicate Assignment Found?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>decAssignmentType</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>No Duplicate</defaultConnectorLabel>
        <rules>
            <name>outDuplicateAssignmentFound</name>
            <conditionLogic>and</conditionLogic>
            <conditions>
                <leftValueReference>varExistingAssignmentId</leftValueReference>
                <operator>IsNull</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>asgSetDuplicateFound</targetReference>
            </connector>
            <label>Duplicate Found</label>
        </rules>
    </decisions>
    <decisions>
        <description>Routes on: &quot;Inputs Present&quot; when inIndicatorDefinitionId and inIndicatorName are not blank AND either (inAssignmentType = &quot;Outcome&quot; with inOutcomeId not blank) or (inAssignmentType = &quot;Program&quot; with inProgramId not blank) -&gt; getExistingIndicatorAssignment; &quot;Invalid Inputs&quot; otherwise -&gt; asgSetInputError.</description>
        <name>decInputsPresent</name>
        <label>Inputs Present?</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <defaultConnector>
            <targetReference>asgSetInputError</targetReference>
        </defaultConnector>
        <defaultConnectorLabel>Invalid Inputs</defaultConnectorLabel>
        <rules>
            <name>outInputsPresent</name>
            <conditionLogic>1 AND 2 AND ((3 AND 4) OR (5 AND 6))</conditionLogic>
            <conditions>
                <leftValueReference>inIndicatorDefinitionId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inIndicatorName</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inAssignmentType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Outcome</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inOutcomeId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inAssignmentType</leftValueReference>
                <operator>EqualTo</operator>
                <rightValue>
                    <stringValue>Program</stringValue>
                </rightValue>
            </conditions>
            <conditions>
                <leftValueReference>inProgramId</leftValueReference>
                <operator>IsBlank</operator>
                <rightValue>
                    <booleanValue>false</booleanValue>
                </rightValue>
            </conditions>
            <connector>
                <targetReference>getExistingIndicatorAssignment</targetReference>
            </connector>
            <label>Inputs Present</label>
        </rules>
    </decisions>
    <description>Creates an Indicator Assignment that links an Indicator Definition to an Outcome or a Programme. If the indicator is already assigned to that record, nothing is created and outDuplicateFound is returned.</description>
    <environments>Default</environments>
    <formulas>
        <description>Assignment name: the indicator name (trimmed to fit) followed by &quot; Assignment&quot;, within the 255-character Name limit.</description>
        <name>frmAssignmentName</name>
        <dataType>String</dataType>
        <expression>LEFT({!inIndicatorName}, 244) &amp; &quot; Assignment&quot;</expression>
    </formulas>
    <formulas>
        <description>The Outcome Id or Programme Id to check for an existing assignment, based on inAssignmentType.</description>
        <name>frmLookupRecordId</name>
        <dataType>String</dataType>
        <expression>IF({!inAssignmentType} = &quot;Outcome&quot;, {!inOutcomeId}, {!inProgramId})</expression>
    </formulas>
    <interviewLabel>Indicator Setup Create Indicator Assignment {!$Flow.CurrentDateTime}</interviewLabel>
    <label>Subflow: Indicator Setup - Create Indicator Assignment</label>
    <processMetadataValues>
        <name>BuilderType</name>
        <value>
            <stringValue>LightningFlowBuilder</stringValue>
        </value>
    </processMetadataValues>
    <processMetadataValues>
        <name>CanvasMode</name>
        <value>
            <stringValue>AUTO_LAYOUT_CANVAS</stringValue>
        </value>
    </processMetadataValues>
    <processType>AutoLaunchedFlow</processType>
    <recordCreates>
        <description>Creates the IndicatorAssignment from recAssignment. Stores the new Id in outIndicatorAssignmentId. On failure, routes to asgSetCreateError.</description>
        <name>rcCreateIndicatorAssignment</name>
        <label>Create Indicator Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>asgSetCreatedAssignmentId</targetReference>
        </connector>
        <faultConnector>
            <targetReference>asgSetCreateError</targetReference>
        </faultConnector>
        <inputReference>recAssignment</inputReference>
    </recordCreates>
    <recordLookups>
        <description>Query IndicatorAssignment for the first record where IndicatorDefinitionId = {!inIndicatorDefinitionId} AND IndicatorAssignmentType = {!inAssignmentType} AND (OutcomeId = {!frmLookupRecordId} OR ProgramId = {!frmLookupRecordId}). Stores Id in varExistingAssignmentId. On failure, routes to asgSetLookupError.</description>
        <name>getExistingIndicatorAssignment</name>
        <label>Get Existing Indicator Assignment</label>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <assignNullValuesIfNoRecordsFound>true</assignNullValuesIfNoRecordsFound>
        <connector>
            <targetReference>decDuplicateAssignmentFound</targetReference>
        </connector>
        <faultConnector>
            <targetReference>asgSetLookupError</targetReference>
        </faultConnector>
        <filterLogic>1 AND 2 AND (3 OR 4)</filterLogic>
        <filters>
            <field>IndicatorDefinitionId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inIndicatorDefinitionId</elementReference>
            </value>
        </filters>
        <filters>
            <field>IndicatorAssignmentType</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>inAssignmentType</elementReference>
            </value>
        </filters>
        <filters>
            <field>OutcomeId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmLookupRecordId</elementReference>
            </value>
        </filters>
        <filters>
            <field>ProgramId</field>
            <operator>EqualTo</operator>
            <value>
                <elementReference>frmLookupRecordId</elementReference>
            </value>
        </filters>
        <object>IndicatorAssignment</object>
        <outputAssignments>
            <assignToReference>varExistingAssignmentId</assignToReference>
            <field>Id</field>
        </outputAssignments>
    </recordLookups>
    <start>
        <locationX>0</locationX>
        <locationY>0</locationY>
        <connector>
            <targetReference>asgInitialiseResult</targetReference>
        </connector>
    </start>
    <status>Active</status>
    <variables>
        <name>inAssignmentType</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inIndicatorDefinitionId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inIndicatorName</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inOutcomeId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>inProgramId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>true</isInput>
        <isOutput>false</isOutput>
    </variables>
    <variables>
        <name>outDuplicateFound</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>false</booleanValue>
        </value>
    </variables>
    <variables>
        <name>outErrorMessage</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>outIndicatorAssignmentId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
    </variables>
    <variables>
        <name>outSucceeded</name>
        <dataType>Boolean</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>true</isOutput>
        <value>
            <booleanValue>true</booleanValue>
        </value>
    </variables>
    <variables>
        <name>recAssignment</name>
        <dataType>SObject</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
        <objectType>IndicatorAssignment</objectType>
    </variables>
    <variables>
        <name>varExistingAssignmentId</name>
        <dataType>String</dataType>
        <isCollection>false</isCollection>
        <isInput>false</isInput>
        <isOutput>false</isOutput>
    </variables>
</Flow>
